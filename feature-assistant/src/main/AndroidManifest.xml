<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Realtime AI call needs mic always, camera in video mode, and audio
         routing / Bluetooth headset support. Declared here so the feature is
         self-contained; these merge into the host manifest. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <application>
        <provider android:name="com.we.meet.feature.assistant.history.AssistantHistoryFileProvider"
            android:authorities="${applicationId}.assistant.history.files"
            android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/assistant_history_paths" />
        </provider>
        <service android:name="com.we.meet.feature.assistant.background.AssistantForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera|mediaPlayback" />
    </application>

</manifest>
