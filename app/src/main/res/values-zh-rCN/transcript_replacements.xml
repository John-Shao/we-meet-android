    <string name="batch_correction_before">修改前</string>
    <string name="batch_correction_after">修改后</string>
    <string name="batch_correction_confirm">确认全部修改</string>
    <string name="batch_correction_pending">尚未确认提交结果。请先重试同一请求，再进行其他修改。</string>
    <string name="batch_correction_retry">重试同一请求</string>
