    <string name="batch_correction_title">批量查找替换</string>
    <string name="batch_correction_hint">对整条记录已保存的原文进行区分大小写的字面替换，包含其他分页。每批最多 100 段；替换内容留空表示删除。未保存草稿和已有纪要保持不变。</string>
    <string name="batch_correction_find">查找内容</string>
    <string name="batch_correction_replacement">替换为</string>
    <string name="batch_correction_preview">预览修改</string>
