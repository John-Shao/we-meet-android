    <string name="batch_correction_deleted">（删除）</string>
    <string name="batch_correction_undo">撤回本次替换</string>
    <string name="batch_correction_undo_hint">将所有受影响段落恢复到本次替换前的文本？如其中任一段已有后续校对，整批撤回都会被拒绝。</string>
    <string name="batch_correction_confirm_undo">确认撤回</string>
