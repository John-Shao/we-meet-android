    <string name="voiceprint_permissions_allow_enrollment_title">Allow me to register and confirm my voice</string>
    <string name="voiceprint_permissions_allow_enrollment_hint">Registration is voluntary. Turning this off revokes this scope\&apos;s voiceprint and stops outstanding registration tasks.</string>
    <string name="voiceprint_permissions_allow_accumulation_title">Allow sampling of my microphone in calls</string>
    <string name="voiceprint_permissions_allow_accumulation_hint">Separate permission for collecting candidate clips from my account\&apos;s microphone. Sampling must be visible and can be paused; it does not confirm a template.</string>
    <string name="voiceprint_permissions_allow_identification_title">Allow matching against my voiceprint</string>
    <string name="voiceprint_permissions_allow_identification_hint">Separate permission to offer my identity as a suggestion within an allowed candidate group. Turning this off stops new matches; it does not change names already confirmed by people.</string>
    <string name="voiceprint_enrollment_title">Register my voice</string>
    <string name="voiceprint_enrollment_hint">Read the displayed prompt alone in a quiet place. Aim for four clips of about eight seconds, with at least 30 seconds in total. No more than six clips per session; each clip must be 3–10 seconds.</string>
