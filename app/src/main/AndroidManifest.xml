<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- Media capture -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Bluetooth audio (headsets) -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Keep cam/mic + media session alive while the app is backgrounded
         during a meeting. Required since API 29; Android 14 additionally
         requires the FOREGROUND_SERVICE_* type permissions. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Screen-share capture: API 34+ requires the mediaProjection FGS type
         permission. The SDK's ScreenCaptureService runs with this type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Required on API 33+ to show the "meeting in progress" notification
         that pins the foreground service. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lets us draw the "stop screen share" floating button on top of the
         desktop / other apps while the user is screen-sharing. Granted
         explicitly by the user via Settings > Special app access on API 23+. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <application
        android:name=".WeMeetApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.WeMeet"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.WeMeet"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                App Links for meeting join URLs. Backend generates only
                8-digit numeric slugs; the wildcard "." (any single
                character) sized to length 9 incl. leading slash narrows
                manifest matching to that shape. Android's pathPattern
                can't express "[0-9]{8}", so other 9-char paths like
                "/feedback" still match here and MainActivity.handleDeepLink
                does the strict final-shape check in code
                (DEEP_LINK_SLUG_REGEX); mismatches fall through to normal
                startup without errors.
                autoVerify="true" makes the system fetch
                https://meet.we-meet.online/.well-known/assetlinks.json
                on install; once that's served by the frontend the App
                takes the link without a chooser. While the JSON is
                missing the App just appears in the chooser alongside
                the browser — still working, just less seamless.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="meet.we-meet.online" />
                <data android:pathPattern="/........" />
            </intent-filter>

            <!--
                Internal deep-link scheme used by push notifications:
                wemeet://im?cid=<conversation id> opens (or foregrounds,
                launchMode=singleTask) the app and stashes the cid on
                WeMeetApp.pendingChatCid for AppNav to route into the chat.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="wemeet" android:host="im" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.ConferenceForegroundService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone|mediaPlayback" />

        <!-- LiveKit ships a bound helper service that pins the MediaProjection
             session while we screen-share. We only need to declare it with the
             right foregroundServiceType — the SDK handles bind/start/stop. -->
        <service
            android:name="io.livekit.android.room.track.screencapture.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- ZXing's CaptureActivity ships locked to sensorLandscape. Our app
             is portrait-only, so we subclass it as PortraitCaptureActivity and
             re-declare it here with sensorPortrait. The library's manifest
             entry is for the base CaptureActivity and is unaffected. -->
        <activity
            android:name=".ui.qrscan.PortraitCaptureActivity"
            android:screenOrientation="sensorPortrait"
            android:stateNotNeeded="true"
            tools:ignore="LockedOrientationActivity" />

        <!-- AutoStoreLocales: lets AppCompatDelegate.setApplicationLocales
             persist + apply per-app language on API 24-32 (API 33+ is
             handled by the system LocaleManager directly). The disabled
             service is the marker AppCompat looks for at startup; the
             meta-data flag flips on the locale storage backed by SharedPrefs. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- ==================== Getui (个推) offline push ==================== -->
        <!-- Credentials are injected as manifestPlaceholders from
             gradle.properties / local.properties (see app/build.gradle.kts).
             Only AppId/AppKey/AppSecret live on the client; the MasterSecret
             stays on the backend. -->
        <meta-data android:name="GETUI_APPID" android:value="${GETUI_APPID}" />
        <meta-data android:name="GETUI_APPKEY" android:value="${GETUI_APPKEY}" />
        <meta-data android:name="GETUI_APPSECRET" android:value="${GETUI_APPSECRET}" />

        <!-- Getui's long-lived push process. Subclassed (empty shell) so the
             service runs under our own component name; ":pushservice" keeps
             it out of the main process per Getui's integration guide. -->
        <service
            android:name=".push.WeMeetPushService"
            android:exported="false"
            android:label="WeMeetPushService"
            android:process=":pushservice" />

        <!-- Receives Getui callbacks (cid, transparent messages) in the main
             process; registered at runtime via
             PushManager.registerPushIntentService in WeMeetApp. -->
        <service
            android:name=".push.WeMeetGtIntentService"
            android:exported="false" />

    </application>

</manifest>
